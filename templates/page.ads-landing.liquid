{% layout 'landing' %}
<div class="only-desktop">
  {% section 'ads-hero' %}
</div>

<div class="only-mobile">
  {% section 'ads-hero-mobile' %}
</div>

<style>
  .only-desktop {
    display: block;
  }

  .only-mobile {
    display: none;
  }
  @media screen and (max-width: 990px) {
    .only-desktop {
      display: none !important;
    }
    .only-mobile {
      display: block !important;
    }
  }
</style>
