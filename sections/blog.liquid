{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {% if section.settings.title != blank %}
      <h2 class="{{ section.settings.heading_size }} text-[#1a0e13] font-bold tracking-[-0.015em] mb-12 text-center">
        {{ section.settings.title }}
      </h2>
    {% endif %}
    {% assign articles = blogs[section.settings.blog].articles | slice: 0, section.settings.items_to_show %}
    {% if section.settings.blog != blank %}
      <div class="blog-posts">
        {% for article in articles limit: section.settings.items_to_show %}
          <div class="blog-post">
            <div class="blog-post__content">
              <p class="blog-post__category">{{ article.tags[0] }}</p>
              <h3 class="blog-post__title">{{ article.title }}</h3>
              <p class="blog-post__excerpt">{{ article.excerpt_or_content | strip_html }}</p>
              <a href="{{ article.url }}" class="blog-post__read-more">Read more</a>
            </div>
            {% if article.image %}
              <div class="blog-post__image-wrapper">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.title }}"
                  class="blog-post__image"
                  width="70"
                  height="70"
                >
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-center text-[#94516a]">Please select a blog in the section settings.</p>
    {% endif %}
  </div>
</div>

<style>
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .blog-posts {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .blog-post {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: center;
      padding: 2rem;
      border-radius: 1rem;
    }

    .blog-post__content {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .blog-post__category {
      color: #94516a;
      font-size: 0.85rem;
    }

    .blog-post__title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a0e13;
      margin: 0.5rem 0;
    }

    .blog-post__excerpt {
      color: #94516a;
      font-size: 1.5rem;
      margin: 0.5rem 0;
      line-height: 1;
    }

    .blog-post__read-more {
      background-color: #f3e7ea;
      color: #1a0e13;
      padding: 0.4rem 1rem;
      border-radius: 0.75rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-block;
      font-size: 1.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
      width: 12rem;
      text-align: center;
  }

  .blog-post__read-more:hover {
      background-color: #e6d1d9;
      color: #1a0e13;
  }

    .blog-post__image-wrapper {
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: flex-end;
    }

    .blog-post__image {
      width: 20rem;
      height: auto;
      max-height: 300px; /* puedes ajustar este valor para que no sea gigante */
      object-fit: cover;
      border-radius: 0.75rem;
    }

    /* Responsive - en mobile stackeado */
    @media screen and (max-width: 768px) {
      .blog-post {
        grid-template-columns: 1fr;
      }

      .blog-post__image-wrapper {
        order: -1;
        justify-content: flex-start;
      }
    }
</style>

{% schema %}
{
  "name": "t:sections.blog.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "items_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 3,
      "label": "t:sections.categories.settings.items_to_show.label"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.categories.settings.title.default",
      "label": "t:sections.categories.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog.presets.name"
    }
  ]
}
{% endschema %}
