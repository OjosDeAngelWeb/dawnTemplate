<section class="ads-hero">
  <main>
    <div class="ads-hero-mobile">
      {% if section.settings.collection %}
        <div class="product-cards-wrapper">
          {% for product in section.settings.collection.products limit: 3 %}
            <div class="product-card">
              <div class="product-info">
                <h2 class="product-title">{{ product.title }}</h2>
                <p class="product-price">
                  <span class="current-price">{{ product.price | money_without_trailing_zeros }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="old-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  {% endif %}
                </p>
                <ul class="product-benefits">
                  <li>• Vibraciones intensas y silenciosas</li>
                  <li>• Tamaño discreto, efecto adictivo</li>
                  <li>• Ideal para rituales en solitario o pareja</li>
                </ul>
                <a href="{{ product.url }}" class="product-button">Lo quiero ya 🔥</a>
              </div>

              {% if product.featured_image %}
                <div class="product-image-wrapper">
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.title }} - juguete íntimo discreto"
                    class="product-image"
                    loading="lazy"
                    width="100%"
                    height="auto"
                  >
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </main>
</section>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Products"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Imagen de fondo del cielo"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Imagen de fondo para móvil (opcional)"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Imagen decorativa (caja)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Juguetes íntimos, lencería celestial y rituales sensuales que encienden tu energía interior."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Explora tu sensualidad con elegancia y magia"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubre tu colección celestial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Título Derecha",
      "default": "✨ \"Una experiencia mágica desde el empaque.\""
    },
    {
      "type": "text",
      "id": "right_subtitle",
      "label": "Subtítulo",
      "default": "✨ \"Calidad, respeto y sensualidad.\""
    },
    {
      "type": "text",
      "id": "righ_button_label",
      "label": "Texto del botón derecho ",
      "default": "Explora ahora"
    },
    {
      "type": "url",
      "id": "right_button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "icon_1_text",
      "label": "Texto Icono1",
      "default": "Envio discreto"
    },
    {
      "type": "text",
      "id": "icon_2_text",
      "label": "Texto Icono2",
      "default": "Empaque elegante"
    },
    {
      "type": "text",
      "id": "icon_3_text",
      "label": "Texto Icono3",
      "default": "Energia mistica"
    },
    {
      "type": "text",
      "id": "icon_4_text",
      "label": "Texto Icono4",
      "default": "Pago seguro"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
