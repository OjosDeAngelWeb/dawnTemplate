<section class="ads-hero">
  <header class="ads-hero__header">
    <p class="ads-hero__title">Explora tu placer con elegancia, magia y total discreción.</p>
  </header>
  <div class="rows-container">
    <div class="contenido">
      <p class="ads-hero__subtitle">
        {{ section.settings.title }}
      </p>
      <a
        href="{{ section.settings.button_link }}"
        class="mobile-ads-hero__button"
      >
        {{ section.settings.button_label }}
      </a>
    </div>
    <div class="mobile-center-container">
      {% if section.settings.box_image != blank %}
        <img
          src="{{ section.settings.box_image | image_url }}"
          width="170%"
          height="auto"
          alt="Caja celestial Ojos de Ángel"
          class="ads-hero__box-bg"
          loading="lazy"
        >
      {% endif %}
      <div class="mobile-lower-center-container">
        <div class="mobile-comentarios-left">
          <p class="mobile-testimonial">
            ✨ “Una experiencia mágica desde el empaque.”<br>
            <span class="autor">— Laura, Medellín</span>
          </p>
          <p class="mobile-testimonial">
            ✨ “Lo compré como regalo, pero terminé usándolo yo. ¡Mágico de verdad!”<br>
            <span class="autor">— Camila, Cali</span>
          </p>
        </div>

        <div class="mobile-iconos-footer">
          <div class="mobile-icono-item">
            <span class="svg-wrapper">{{- 'icon-shipment.svg' | inline_asset_content -}}</span>
            <p class="mobile-icono-item-text">{{ section.settings.icon_1_text }}</p>
          </div>
          <div class="mobile-icono-item">
            <span class="svg-wrapper">{{- 'icon-gift.svg' | inline_asset_content -}}</span>
            <p class="mobile-icono-item-text">{{ section.settings.icon_2_text }}</p>
          </div>
          <div class="mobile-icono-item">
            <span class="svg-wrapper">{{- 'icon-mysthic.svg' | inline_asset_content -}}</span>
            <p class="mobile-icono-item-text">{{ section.settings.icon_3_text }}</p>
          </div>
          <div class="mobile-icono-item">
            <span class="svg-wrapper">{{- 'icon-secure-card.svg' | inline_asset_content -}}</span>
            <p class="mobile-icono-item-text">{{ section.settings.icon_4_text }}</p>
          </div>
        </div>
      </div>
      <div class="mobile-contenido">
        <p class="mobile-ads-hero__subtitle">
          {{ section.settings.right_title }}
        </p>
        <p class="mobile-ads-hero__subtitle">
          {{ section.settings.right_subtitle }}
        </p>
        <a
          href="{{ section.settings.right_button_link }}"
          class="mobile-ads-hero__button"
        >
          {{ section.settings.righ_button_label }}
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  html,
  body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden; /* evita scroll horizontal por desbordes */
    margin: 0;
    padding: 0;
  }

  .mobile-ads-hero {
    width: 100vw;
    max-width: 100vw;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .page-width {
    max-width: none !important;
    width: 100% !important;
  }
</style>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Imagen de fondo del cielo"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Imagen de fondo para móvil (opcional)"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Imagen decorativa (caja)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Juguetes íntimos, lencería celestial y rituales sensuales que encienden tu energía interior."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Explora tu sensualidad con elegancia y magia"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubre tu colección celestial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Título Derecha",
      "default": "✨ \"Una experiencia mágica desde el empaque.\""
    },
    {
      "type": "text",
      "id": "right_subtitle",
      "label": "Subtítulo",
      "default": "✨ \"Calidad, respeto y sensualidad.\""
    },
    {
      "type": "text",
      "id": "righ_button_label",
      "label": "Texto del botón derecho ",
      "default": "Explora ahora"
    },
    {
      "type": "url",
      "id": "right_button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "icon_1_text",
      "label": "Texto Icono1",
      "default": "Envio discreto"
    },
    {
      "type": "text",
      "id": "icon_2_text",
      "label": "Texto Icono2",
      "default": "Empaque elegante"
    },
    {
      "type": "text",
      "id": "icon_3_text",
      "label": "Texto Icono3",
      "default": "Energia mistica"
    },
    {
      "type": "text",
      "id": "icon_4_text",
      "label": "Texto Icono4",
      "default": "Pago seguro"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
