<section class="ads-hero">
  <main>
    <div class="ads-hero-mobile">
      <div class="logo-title-wrapper">
        <div class="logo-header">
          <img
            src="{{ settings.logo | image_url: width: 500 }}"
            alt="logo"
            class="logo-image"
            loading="lazy"
            width="100%"
            height="auto"
          >
        </div>
        <h1 class="golden-title">{{ section.settings.store_name }}</h1>
      </div>
      <div class="free-shipping-banner animated-shine">✨ Envío GRATIS por compras desde <strong>$120.000</strong></div>
      <div class="cod-banner">
        <p class="cod-title">🚚✨ <strong>¿Estás en Medellín y el area metropolitana?</strong></p>
        <p class="cod-subtitle">Paga al recibir tu pedido con opción <strong>contra entrega</strong> 🛍️</p>
      </div>
      <div class="hero-text">
        <h1 class="hero-title">{{ section.settings.title }}</h1>
        <h2 class="hero-subtitle">{{ section.settings.subtitle }}</h2>
        <p class="hero-description">{{ section.settings.description }}</p>
      </div>
      <div class="magic-buttons">
        <a href="{{ routes.all_products_collection_url }}" class="button-orange">{{ section.settings.button_label }}</a>
        <a href="{{ routes.root_url }}" class="button-lavender">{{ section.settings.button_label_shopping }}</a>
      </div>
      {% if section.settings.collection %}
        <div class="product-cards-wrapper">
          {% for product in section.settings.collection.products limit: 3 %}
            <div class="product-card">
              <div class="product-info">
                <h2 class="product-title">{{ product.title }}</h2>
                <p class="product-price">
                  <span class="current-price">{{ product.price | money_without_trailing_zeros }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="old-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  {% endif %}
                </p>
                {% if product.metafields.custom.featuredtext != blank %}
                  {% assign featured_items = product.metafields.custom.featuredtext.value | split: ' | ' %}
                  <ul class="product-benefits">
                    {% for item in featured_items %}
                      <li>• {{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
                <a href="{{ product.url }}" class="product-button">Lo quiero ya 🔥</a>
              </div>

              {% if product.featured_image %}
                <div class="product-image-wrapper">
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.title }} - juguete íntimo discreto"
                    class="product-image"
                    loading="lazy"
                    width="100%"
                    height="auto"
                  >
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
      <div class="benefits-block">
        <div class="benefit">
          <div class="icon-circle lavender">
            <img
              src="{{ 'freeShip.svg' | asset_url }}"
              alt="Ícono envío discreto"
              class="benefit-icon"
              width="40"
              height="40"
            >
          </div>
          <div class="benefit-text">
            <h3>Envío discreto</h3>
            <p>Sin logos. Nadie sabrá lo que llega… salvo tú.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="icon-circle peach">
            <img
              src="{{ 'package.svg' | asset_url }}"
              alt="Ícono empaque elegante"
              class="benefit-icon"
              width="40"
              height="40"
            >
          </div>
          <div class="benefit-text">
            <h3>Empaque elegante</h3>
            <p>Empaque mágico que eleva el placer desde el primer vistazo.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="icon-circle blue">
            <img
              src="{{ 'pago.svg' | asset_url }}"
              alt="Ícono pago seguro"
              class="benefit-icon"
              width="40"
              height="40"
            >
          </div>
          <div class="benefit-text">
            <h3>Paga seguro</h3>
            <p>Pagos cifrados y confiables.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="icon-circle purple">
            <img
              src="{{ 'energia.svg' | asset_url }}"
              alt="Ícono energia mistica"
              class="benefit-icon"
              width="40"
              height="40"
            >
          </div>
          <div class="benefit-text">
            <h3>Energía mística</h3>
            <p>Cada producto elegido con intención: placer, conexión y expansión.</p>
          </div>
        </div>
      </div>

      <div class="testimonial-section">
        <h2 class="testimonial-heading">✨ Lo que dicen nuestras almas celestiales</h2>

        <div class="testimonial-cards">
          <div class="testimonial-card">
            <p class="testimonial-text">
              “Me llegó rapidísimo, en una cajita preciosa. Nadie sospechó nada. ¡Ya quiero pedir más!”
            </p>
            <p class="testimonial-author">— Valentina R.</p>
          </div>

          <div class="testimonial-card">
            <p class="testimonial-text">✨ “Pensé que era un regalo para ella… y terminamos usándolo juntos.”</p>
            <p class="testimonial-author">— Andrés & Lina, Medellín.</p>
          </div>

          <div class="testimonial-card">
            <p class="testimonial-text">
              “Me encantó la atención, los detalles y la energía del paquete. Todo se sintió especial.”
            </p>
            <p class="testimonial-author">— Camila D.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</section>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Products"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Imagen Logo"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Nombre de la tienda",
      "default": "Ojos de Ángel"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Placer celestial directo a tu puerta"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Juguetes y lencería con envío discreto"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descripción",
      "default": "Productos íntimos irresistibles para regalar(te) placer, misterio y conexión. Compra hoy y recibe sorpresa especial ✨"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón productos",
      "default": "🔥 Ver productos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón productos",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_shopping",
      "label": "Texto del botón compra",
      "default": "✨ Comprar con envío gratis desde $120.000"
    },
    {
      "type": "url",
      "id": "button_link_shopping",
      "label": "Enlace del botón compra",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
