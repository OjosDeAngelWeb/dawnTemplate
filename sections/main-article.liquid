{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

<article class="article-template">
  <section class="ritual-section">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          <div class="hero">
            <h1>{{ article.title | escape }}</h1>
            <img
              srcset="{{ article.image | image_url: width: 350 }}"
              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
              src="{{ article.image | image_url: width: 1100 }}"
              loading="eager"
              fetchpriority="high"
              width="500"
              height="500"
              alt="{{ article.image.alt | escape }}"
              class="hero-image"
            >
          </div>
        {%- when 'content' -%}
          <div class="blog-layout">
            <aside class="sidebar">
              <h3>Categorías</h3>
              <ul class="category-list">
                {% for tag in blog.all_tags %}
                  {% unless tag contains 'frase:' %}
                    <li>
                      <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                    </li>
                  {% endunless %}
                {% endfor %}
              </ul>
            </aside>
            <div class="article-body-with-right">
              <div class="rte article-body">
                {{ article.content }}
              </div>
            </div>
            <aside class="right-column">
              {% assign frase_tag = '' %}
              {% for tag in article.tags %}
                {% if tag contains 'frase:' %}
                  {% assign frase_tag = tag | remove: 'frase:' | strip %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% if frase_tag != '' %}
                {% assign frase = frase_tag | remove: 'frase:' %}
                <div class="sidebar-quote">
                  <blockquote>
                    <span class="quote-icon">✨</span>
                    <p>{{ frase }}</p>
                  </blockquote>
                </div>
              {% endif %}

              <div class="blog-featured-products">
                {% for product in collections.lenceria.products limit: 2 %}
                  <div class="blog-product-card">
                    <a href="{{ product.url }}">
                      <img
                        src="{{ product.featured_image | image_url: width: 300 }}"
                        alt="{{ product.title }}"
                        width="300"
                        height="300"
                      >
                      <p class="product-title">{{ product.title }}</p>
                    </a>
                  </div>
                {% endfor %}
              </div>
              <!--
                <div class="newsletter-box">
                      <p class="newsletter-text">¿Te gustó este artículo?</p>
                      <a href="/pages/suscripcion" class="subscribe-button">Recibe más placer celestial ✨</a>
                    </div>
                  </aside>
                </div>
              -->
      {%- endcase -%}
    {%- endfor -%}

    {% assign articles = blog.articles %}
    {% assign current_article_index = -1 %}

    {% for a in articles %}
      {% if a.id == article.id %}
        {% assign current_article_index = forloop.index0 %}
      {% endif %}
    {% endfor %}

    <div class="blog-navigation-cards">
      {% if current_article_index > 0 %}
        {% assign previous_index = current_article_index | minus: 1 %}
        {% assign previous_article = articles[previous_index] %}
        <a href="{{ previous_article.url }}" class="blog-nav-compact-card">
          <div class="nav-image-wrapper">
            <img
              src="{{ previous_article.image | image_url: width: 400 }}"
              alt="{{ previous_article.title }}"
              width="400"
              height="400"
            >
          </div>
          <span class="nav-label">← Artículo anterior</span>
          <h4>{{ previous_article.title }}</h4>
        </a>
      {% endif %}

      {% assign next_index = current_article_index | plus: 1 %}
      {% if next_index < articles.size %}
        {% assign next_article = articles[next_index] %}
        <a href="{{ next_article.url }}" class="blog-nav-compact-card">
          <div class="nav-image-wrapper">
            <img
              src="{{ next_article.image | image_url: width: 400 }}"
              alt="{{ next_article.title }}"
              width="400"
              height="400"
            >
          </div>
          <span class="nav-label">Artículo siguiente →</span>
          <h4>{{ next_article.title }}</h4>
        </a>
      {% endif %}
    </div>
  </section>

  <div class="article-template__back element-margin-top center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <a href="{{ blog.url }}" class="article-template__link link animate-arrow">
      <span class="icon-wrap">
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </span>
      {{ 'blogs.article.back_to_blog' | t: title: blog.title | escape }}
    </a>
  </div>
  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div
        id="comments"
        class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchor_id = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchor_id %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<style>
  body {
    margin: 0;
    padding: 0;
    font-family: 'Georgia', serif;
    color: #1a0e13;
    background: #fef6f9;
  }

  .blog-columns {
    display: flex;
    gap: 3rem;
  }

  .left-column,
  .right-column {
    width: 50%;
  }

  .ritual-section {
    background: linear-gradient(to bottom, #f7edf5, #fff6f9);
    text-align: center;
    padding-bottom: 4rem;
  }

  .hero {
    background: #fce5f6;
    position: relative;
    text-align: center;
  }

  .hero h1 {
    font-size: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
    line-height: 1.3;
  }

  .subhead {
    font-size: 1.1rem;
    margin-top: 1rem;
    color: #333;
  }

  .hero-image {
    max-height: 500px;
    width: auto;
    height: auto;
    max-width: 90vw;
    display: block;
    margin: 2rem auto;
    object-fit: contain;
    opacity: 0.9;
  }

  .content {
    display: flex;
    justify-content: space-between;
    padding: 4rem 3rem 2rem;
    gap: 2rem;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: auto;
  }

  .text-column {
    flex: 1;
    text-align: left;
    max-width: 600px;
  }

  .text-column p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .main-paragraph {
    font-weight: bold;
  }

  .quote {
    flex: 1;
    text-align: left;
    font-style: italic;
    color: #b1811a;
    font-size: 1.2rem;
    max-width: 500px;
    align-self: center;
  }

  .footer-blog {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 3rem 1rem;
    flex-wrap: wrap;
  }

  .footer-image {
    border-radius: 10px;
    max-width: 300px;
    height: auto;
  }

  .footer-text {
    text-align: left;
  }

  .like {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .button-more {
    padding: 0.75rem 2rem;
    background-color: #b481a6;
    color: white;
    border-radius: 999px;
    text-decoration: none;
    display: inline-block;
    font-weight: bold;
    transition: background 0.3s ease;
  }

  .button-more:hover {
    background-color: #a86a8c;
  }

  .related {
    font-size: 1.5rem;
    margin-top: 3rem;
  }

  .article-template .rte {
    column-count: 1;
    max-width: 70%;
    margin-left: auto;
    margin-right: auto;
    overflow-wrap: break-word;
    word-break: break-word;
    text-align: justify;
  }

  @media (max-width: 990px) {
    .article-template .rte {
      column-count: 1;
      max-width: 95%;
      padding: 0 1rem;
    }
  }

  .article-template .rte p,
  h3 {
    text-align: justify;
  }

  .blog-layout {
    display: flex;
    gap: 4rem;
    padding: 2rem 4rem;
    max-width: 1400px;
    margin: auto;
    flex-direction: row;
  }

  .sidebar {
    width: 25%;
    padding: 2rem 1rem;
    background-color: #fef6f9;
    border-radius: 1rem;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.03);
  }

  .sidebar h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: #1a0e13;
  }

  .category-list {
    list-style: none;
    padding-left: 0;
  }

  .category-list li {
    margin-bottom: 0.8rem;
  }

  .category-list a {
    color: #b481a6;
    text-decoration: none;
    font-weight: 500;
  }

  .category-list a:hover {
    text-decoration: underline;
  }

  .article-body {
    flex: 1;
    text-align: justify;
    padding-top: 2rem;
    max-width: 800px;
  }

  .article-body-with-right {
    display: flex;
    flex-direction: row;
    gap: 3rem;
    width: 100%;
  }

  .right-column {
    width: 30%;
    background-color: #fbf5fa;
    border-left: 1px solid #eee;
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-quote {
    font-style: italic;
    color: #94516a;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .blog-featured-products {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-product-card {
    background: white;
    padding: 1rem;
    border-radius: 1rem;
    text-align: center;
    border: 1px solid #f2d6e0;
    transition: transform 0.2s ease;
  }

  .blog-product-card img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
    display: block;
    margin: 0 auto 0.5rem auto;
    border-radius: 1rem;
  }

  .blog-product-card:hover {
    transform: translateY(-2px);
  }

  .product-title {
    color: #1a0e13;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .newsletter-box {
    background-color: #f2e8ec;
    padding: 1rem;
    border-radius: 1rem;
    text-align: center;
  }

  .subscribe-button {
    display: inline-block;
    margin-top: 0.5rem;
    background: #b481a6;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: bold;
  }

  .quote-icon {
    font-size: 1.25rem;
    color: #dabfa9;
    margin-right: 0.5rem;
  }

  @media (max-width: 990px) {
    .blog-layout {
      flex-direction: column;
      padding: 1rem;
    }

    .sidebar {
      width: 100%;
      order: 0;
    }

    .article-body-with-right {
      flex-direction: column;
      order: -1;
    }

    .article-body {
      max-width: 100%;
      padding: 1rem 0;
    }

    .right-column {
      width: 100%;
      padding: 1rem 0;
      border-left: none;
      border-top: 1px solid #eee;
    }
  }

  main#MainContent {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .hero {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .ritual-section {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .blog-navigation-cards {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 4rem;
    padding: 2rem 1rem;
    border-top: 1px solid #f2d6e0;
    flex-wrap: wrap;
  }

  .blog-nav-compact-card {
    width: 200px;
    height: 250px; /* ← Establece altura fija */
    background-color: #fce5f6;
    border-radius: 1rem;
    text-align: center;
    text-decoration: none;
    color: #1a0e13;
    padding: 1rem;
    transition: background-color 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin: 0 1rem;
  }

  .blog-nav-compact-card:hover {
    background-color: #f2c8d9;
  }

  .blog-nav-compact-card img {
    width: 100%;
    height: auto;
    max-height: 120px;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .blog-nav-compact-card .nav-label {
    font-size: 1.5rem;
    color: #94516a;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .blog-nav-compact-card h4 {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.4;
    font-weight: 600;
    max-height: 4.2em; /* evita que se salga */
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3; /* máximo 3 líneas */
    -webkit-box-orient: vertical;
  }

  .nav-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .nav-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 990px) {
    .blog-navigation {
      flex-direction: column;
    }

    .blog-nav-card {
      max-width: 100%;
    }
  }

  @media (max-width: 990px) {
    .blog-navigation-cards {
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
    }

    .blog-nav-compact-card {
      max-width: 100%;
      text-align: center !important;
      align-self: center !important;
    }
  }
</style>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__1.label"
            },
            {
              "value": "small",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__2.label"
            },
            {
              "value": "medium",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__3.label"
            },
            {
              "value": "large",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__4.label"
            }
          ],
          "default": "adapt",
          "label": "t:sections.main-article.blocks.featured_image.settings.image_height.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-article.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_date.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": false,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_author.label"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1
    },
    {
      "type": "share",
      "name": "t:sections.main-article.blocks.share.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "t:sections.main-article.blocks.share.settings.text.label",
          "default": "t:sections.main-article.blocks.share.settings.text.default"
        }
      ]
    }
  ]
}
{% endschema %}
