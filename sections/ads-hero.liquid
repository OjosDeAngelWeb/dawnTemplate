<section class="ads-hero ">
  <header class="ads-hero__header">
    <div class="logo"></div>
    <div class="menu_links">
      {% assign collection = section.settings.menu.links %}
      {% for subcollection in collection %}
        <a href="{{ subcollection.url }}">
          <h3 class="collection_link">{{ subcollection.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </header>
  <main>
    <div class="ads-hero__section z-index-1">
      <div class="contenido">
        <h1 class="ads-hero__title">
          {{ section.settings.title }}
        </h1>

        <p class="ads-hero__subtitle">
          {{ section.settings.subtitle }}
        </p>
        <a
          href="{{ section.settings.button_link }}"
          class="ads-hero__button"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    </div>
    <div class="ads-hero__section__center">
      <div class="center-container">
        {%- if section.settings.box_image != blank -%}
          <img
            src="{{ section.settings.box_image | image_url }}"
            width="170%"
            height="auto"
            alt="Caja celestial Ojos de Ángel"
            class="ads-hero__box-bg"
            loading="lazy"
          >
        {%- endif -%}
        <div class="iconos-footer">
          <div class="icono-item">
            <span class="svg-wrapper">
              {{- 'icon-shipment.svg' | inline_asset_content -}}
            </span>
            <p>{{ section.settings.icon_1_text }}</p>
          </div>
          <div class="icono-item">
            <span class="svg-wrapper">
              {{- 'icon-gift.svg' | inline_asset_content -}}
            </span>
            <p>{{ section.settings.icon_2_text }}</p>
          </div>
          <div class="icono-item">
            <span class="svg-wrapper">
              {{- 'icon-mysthic.svg' | inline_asset_content -}}
            </span>
            <p>{{ section.settings.icon_3_text }}</p>
          </div>
          <div class="icono-item">
            <span class="svg-wrapper">
              {{- 'icon-secure-card.svg' | inline_asset_content -}}
            </span>
            <p>{{ section.settings.icon_4_text }}</p>
          </div>
        </div>
      </div>
    </div>
    <div class="ads-hero__section z-index-1">
      <div class="contenido">
        <p class="ads-hero__subtitle">
          {{ section.settings.right_title }}
        </p>

        <p class="ads-hero__subtitle">
          {{ section.settings.right_subtitle }}
        </p>
        <a
          href="{{ section.settings.right_button_link }}"
          class="ads-hero__button"
        >
          {{ section.settings.righ_button_label }}
        </a>
      </div>
    </div>
  </main>
  <footer></footer>
</section>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .ads-hero {
    height: 100%;
    font-family: 'Georgia', serif;
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at center, #f7e7e1 0%, #e5d9f2 40%, #e0f1f9 100%);
  }

  .ads-hero {
    background-size: 200% 200%;
    background-repeat: no-repeat;
    animation: floatClouds 5s ease-in-out infinite;
  }

  /* Animación de fondo */
  @keyframes floatClouds {
    0% {
      background-position: 0% 0%;
    }
    25% {
      background-position: 100% 0%;
    }
    50% {
      background-position: 100% 100%;
    }
    75% {
      background-position: 0% 100%;
    }
    100% {
      background-position: 0% 0%;
    }
  }

  header,
  footer {
    height: 10vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  main {
    height: 80vh;
    display: flex;
    overflow: hidden;
  }

  .ads-hero__section {
    flex: 2;
    margin: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .ads-hero__section__center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .z-index-1 {
    z-index: 1;
  }

  .ads-hero__section .contenido {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .center-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .ads-hero__box-bg {
    max-width: none;
    margin-top: auto;
    margin-bottom: auto;
    z-index: 0;
  }

  .iconos-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1rem 2rem;
    position: relative;
    bottom: 0;
  }

  .icono-item {
    flex: 1;
    text-align: center;
  }

  .svg-wrapper {
    width: 40px;
    height: 40px;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }

  .icono-item p {
    font-size: 0.9rem;
    color: #333;
  }

  .ads-hero__button {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    background-color: #d1b18e;
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .ads-hero__button:hover {
    background-color: #a67a8c;
  }

  .ads-hero h1 {
    font-size: 3.8rem;
    font-weight: 500;
    line-height: 1.1;
    color: #1a0e13;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .ads-hero__subtitle {
    font-size: 2rem;
    line-height: 1.1;
    color: #1a0e13;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .icono-item p {
    font-size: 1rem;
  }

  /* 🌐 Estilo mobile tipo app */
  @media screen and (max-width: 990px) {
    header,
    footer {
      display: none; /* Ocultar header y footer en mobile */
    }

    body {
      height: 100vh;
    }

    main {
      flex: 1;
      height: 100vh;
      flex-direction: column;
      overflow-y: auto; /* Scroll vertical */
    }

    .ads-hero__section {
      flex: none;
      width: 100%;
      height: 100vh; /* Cada sección ocupa la pantalla completa */
    }

    .iconos-footer {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .icono-item {
      width: 45%; /* Antes usábamos flex: 1 o width: 100% */
      flex-basis: 45%;
    }

    .ads-hero__box-bg {
      max-width: 100%;
      margin-top: auto;
      margin-bottom: auto;
      z-index: 0;
    }

    .svg-wrapper {
      width: 50%;
      height: 50%;
      object-fit: contain;
      margin-bottom: 0.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Imagen de fondo del cielo"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Imagen de fondo para móvil (opcional)"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Imagen decorativa (caja)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Tu deseo también es luz"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Explora tu sensualidad con elegancia y magia"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubre tu colección celestial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Título Derecha",
      "default": "✨ \"Una experiencia mágica desde el empaque.\""
    },
    {
      "type": "text",
      "id": "right_subtitle",
      "label": "Subtítulo",
      "default": "✨ \"Calidad, respeto y sensualidad.\""
    },
    {
      "type": "text",
      "id": "righ_button_label",
      "label": "Texto del botón derecho ",
      "default": "Explora ahora"
    },
    {
      "type": "url",
      "id": "right_button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "icon_1_text",
      "label": "Texto Icono1",
      "default": "Envio discreto"
    },
    {
      "type": "text",
      "id": "icon_2_text",
      "label": "Texto Icono2",
      "default": "Empaque elegante"
    },
    {
      "type": "text",
      "id": "icon_3_text",
      "label": "Texto Icono3",
      "default": "Energia mistica"
    },
    {
      "type": "text",
      "id": "icon_4_text",
      "label": "Texto Icono4",
      "default": "Pago seguro"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
