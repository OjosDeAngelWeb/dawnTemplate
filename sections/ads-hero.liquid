<section class="ads-hero">
  <div class="ads-hero__layout">
    <div class="ads-hero__header">
      <div class="logo"></div>
      <div class="menu_links">
        {% assign collection = section.settings.menu.links %}
        {% for subcollection in collection %}
          <a href="{{ subcollection.url }}">
            <h3 class="collection_link">{{ subcollection.title }}</h3>
          </a>
        {% endfor %}
      </div>
    </div>
    <div class="ads-hero__content">
      <div class="ads-hero__left">
        <h1 class="ads-hero__title">
          {{ section.settings.title }}
        </h1>
        <p class="ads-hero__subtitle">
          {{ section.settings.subtitle }}
        </p>
        <a
          href="{{ section.settings.button_link }}"
          class="ads-hero__button"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
      {%- if section.settings.box_image != blank -%}
        <img
          src="{{ section.settings.box_image | image_url }}"
          width="20rem"
          height="500rem"
          alt="Caja celestial Ojos de Ángel"
          class="ads-hero__box-bg"
          loading="lazy"
        >
      {%- endif -%}
      <div class="ads-hero__right">
        <p class="ads-hero__title">
          {{ section.settings.right_title }}
        </p>
        <p class="ads-hero__subtitle">
          {{ section.settings.right_subtitle }}
        </p>
        <a
          href="{{ section.settings.right_button_link }}"
          class="ads-hero__button"
        >
          {{ section.settings.righ_button_label }}
        </a>
      </div>
    </div>
    <div class="ads-hero__benefits">
      <div>
        <img src="{{ 'icon-envio.svg' | asset_url }}" alt="Envío discreto">
        <p>Envío discreto</p>
      </div>
      <div>
        <img src="{{ 'icon-empaque.svg' | asset_url }}" alt="Empaque elegante">
        <p>Empaque elegante</p>
      </div>
      <div>
        <img src="{{ 'icon-seguro.svg' | asset_url }}" alt="Pago seguro">
        <p>Paso seguro</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ads-hero__layout {
    display: table;
  }

  .ads-hero {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: left;
    text-align: left;
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 30% 30%, #f6eaf1, #e8effc 40%, #e6e0f8 100%);
  }

  .ads-hero__content {
    display: flex;
    position: relative;
    justify-content: center;
    z-index: 2;
  }

  .ads-hero__quotes {
    flex: 1;
    min-width: 250px;
    color: #4c3a4f;
    font-size: 1.1rem;
    font-weight: 500;
    display: flex;
    z-index: 2;
    flex-direction: column;
    gap: 1rem;
    max-width: 360px;
  }

  .ads-hero__benefits {
    display: flex;
    justify-content: center;
    align-items: top;
    gap: 3rem;
    margin-top: 3rem;
    z-index: 2;
    position: relative;
  }

  .ads-hero__right {
    text-align: right;
    z-index: 2;
    position: relative;
  }

  .ads-hero__left {
    text-align: left;
    z-index: 2;
    position: relative;
  }

  .ads-hero h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .ads-hero p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #4c3a4f;
  }

  .ads-hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ads-hero__button {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    background-color: #d1b18e;
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .ads-hero__button:hover {
    background-color: #a67a8c;
  }

  .ads-hero__image {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 40%;
    z-index: 1;
    pointer-events: none;
  }

  .ads-hero__box-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 400px; /* antes era 500px */
    max-height: 700px;
    width: 90%;
    z-index: 0;
    opacity: 1;
    pointer-events: none;
  }

  @media screen and (max-width: 990px) {
    .ads-hero {
      text-align: center;
      padding: 4rem 1.5rem;
    }

    .adshero h1 {
      font-size: 2rem;
    }

    .ads-hero p {
      font-size: 1rem;
    }

    .ads-hero__image {
      max-width: 70%;
      left: 50%;
      transform: translateX(-50%);
      bottom: 0;
    }

    .ads-hero__buttons {
      justify-content: center;
    }

    .ads-hero__box-bg {
      max-width: 300px;
    }
  }
</style>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Imagen de fondo del cielo"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Imagen de fondo para móvil (opcional)"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Imagen decorativa (caja)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Tu deseo también es luz. ✨"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Explora tu sensualidad desde lo más alto."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubre tu colección celestial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Título Derecha",
      "default": "\"✨ Una experiencia mágica desde el empaque.\""
    },
    {
      "type": "text",
      "id": "right_subtitle",
      "label": "Subtítulo",
      "default": "\"✨ Calidad, respeto y sensualidad.\""
    },
    {
      "type": "text",
      "id": "righ_button_label",
      "label": "Texto del botón derecho ",
      "default": "Explora ahora"
    },
    {
      "type": "url",
      "id": "right_button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
