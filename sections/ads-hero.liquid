<section class="ads-hero {% if section.settings.background_mobile != blank %}has-mobile-bg{% endif %}">
  {%- if section.settings.box_image != blank -%}
    <img
      src="{{ section.settings.box_image | image_url }}"
      width="20rem"
      height="500rem"
      alt="Caja celestial Ojos de Ángel"
      class="ads-hero__box-bg"
      loading="lazy"
    >
  {%- endif -%}
  <div class="ads-hero__content">
    <h1 class="text-[#1a0e13] text-4xl md:text-5xl font-black leading-tight tracking-[-0.03em] mb-4">
      {{ section.settings.title }}
    </h1>
    <p class="text-[#94516a] text-base md:text-lg font-medium leading-normal mb-6 max-w-xl mx-auto">
      {{ section.settings.subtitle }}
    </p>
    <a
      href="{{ section.settings.button_link }}"
      class="ads-hero__button"
    >
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

<style>
  .ads-hero {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: left;
    text-align: left;
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 30% 30%, #f6eaf1, #e8effc 40%, #e6e0f8 100%);
  }

  .ads-hero__content {
    position: relative;
    z-index: 2;
  }

  .ads-hero h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .ads-hero p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #4c3a4f;
  }

  .ads-hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ads-hero__button {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    background-color: #d1b18e;
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .ads-hero__button:hover {
    background-color: #a67a8c;
  }

  .ads-hero__image {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 40%;
    z-index: 1;
    pointer-events: none;
  }

  .ads-hero__box-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 400px; /* antes era 500px */
    max-height: 700px;
    width: 90%;
    z-index: 0;
    opacity: 1;
    pointer-events: none;
  }

  @media screen and (max-width: 990px) {
    .ads-hero {
      text-align: center;
      padding: 4rem 1.5rem;
    }

    .adshero h1 {
      font-size: 2rem;
    }

    .ads-hero p {
      font-size: 1rem;
    }

    .ads-hero__image {
      max-width: 70%;
      left: 50%;
      transform: translateX(-50%);
      bottom: 0;
    }

    .ads-hero__buttons {
      justify-content: center;
    }

    .ads-hero__box-bg {
      max-width: 300px;
    }
  }
</style>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Imagen de fondo del cielo"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Imagen de fondo para móvil (opcional)"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Imagen decorativa (caja)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Tu deseo también es luz. ✨"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Explora tu sensualidad desde lo más alto."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubre tu colección celestial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
