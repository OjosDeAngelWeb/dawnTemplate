<section class="ads-hero {% if section.settings.background_mobile != blank %}has-mobile-bg{% endif %}">
  <div class="ads-hero__content">
    <h1 class="ads-hero__title">Tu deseo también es luz ✨</h1>
    <p class="ads-hero__subtitle">Explora tu sensualidad con elegancia y magia</p>
    <a href="/collections/all" class="ads-hero__button">Descubrir colección</a>
  </div>
  {% if section.settings.box_image != blank %}
    <img
      class="landing-hero__image"
      src="{{ section.settings.box_image | image_url: width: 800 }}"
      alt="Caja Ojos de Ángel"
      width="{{ section.settings.box_image.width }}"
      height="{{ section.settings.box_image.height }}"
    >
  {% endif %}
</section>

<style>
  .ads-hero {
    position: relative;
    padding: 6rem 1.5rem;
    text-align: left;
    background-image: url({{ section.settings.background | image_url }});
    color: #1a0e13;
    overflow: hidden;
  }

  .adshero__content {
    max-width: 600px;
    position: relative;
    z-index: 2;
  }

  .ads-hero h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .ads-hero p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #4c3a4f;
  }

  .ads-hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ads-hero__button {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    background-color: #d1b18e;
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .ads-hero__button:hover {
    background-color: #a67a8c;
  }

  .ads-hero__image {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 40%;
    z-index: 1;
    pointer-events: none;
  }

  @media screen and (max-width: 990px) {
    .ads-hero {
      background-image: url({{ section.settings.background_mobile | image_url }});
      text-align: center;
      padding: 4rem 1.5rem;
    }

    .adshero h1 {
      font-size: 2rem;
    }

    .ads-hero p {
      font-size: 1rem;
    }

    .ads-hero__image {
      max-width: 70%;
      left: 50%;
      transform: translateX(-50%);
      bottom: 0;
    }

    .ads-hero__buttons {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Landing Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Imagen de fondo del cielo"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Imagen de fondo para móvil (opcional)"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Imagen decorativa (caja)"
    }
  ],
  "presets": [
    {
      "name": "Landing Hero"
    }
  ]
}
{% endschema %}
